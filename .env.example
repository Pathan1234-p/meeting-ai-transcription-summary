# Environment variables for Meeting AI Documentation Prototype

# Hugging Face access token (optional, for pyannote.audio speaker diarization)
# If not provided, the pipeline gracefully falls back to "Speaker unknown"
HF_TOKEN=

# ASR Model configuration: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Abstractive summarization backend: 'local' (Hugging Face) or 'api'
SUMMARIZER_BACKEND=local
SUMMARIZER_MODEL_NAME=sshleifer/distilbart-cnn-12-6

# NLI Factuality / Hallucination guard model
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# Optional API Keys if SUMMARIZER_BACKEND=api
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Seed for reproducibility
RANDOM_SEED=42
